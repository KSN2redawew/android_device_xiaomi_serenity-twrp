system              /system          erofs   ro      wait,logical,first_stage_mount,slotselect
system_ext          /system_ext      erofs   ro      wait,logical,first_stage_mount,slotselect
vendor              /vendor          erofs   ro      wait,logical,first_stage_mount,slotselect
odm                 /odm             erofs   ro      wait,logical,first_stage_mount,slotselect
product             /product         erofs   ro      wait,logical,first_stage_mount,slotselect
vendor_dlkm         /vendor_dlkm     erofs   ro      wait,logical,first_stage_mount,slotselect
system_dlkm         /system_dlkm     erofs   ro      wait,logical,first_stage_mount,slotselect

/dev/block/by-name/metadata     /metadata        ext4    nodev,noatime,nosuid,errors=panic      wait,formattable,first_stage_mount
/dev/block/by-name/userdata     /data            f2fs    noatime,nosuid,nodev,discard,gc_merge  wait,check,formattable
/dev/block/by-name/rescue       /mnt/rescue      ext4    rw,noatime,nosuid,nodev                wait,check
/dev/block/by-name/misc         /misc            emmc    defaults                               defaults

/dev/block/by-name/boot         /boot            emmc    defaults                               slotselect
/dev/block/by-name/init_boot    /init_boot       emmc    defaults                               slotselect
/dev/block/by-name/vendor_boot  /vendor_boot     emmc    defaults                               slotselect