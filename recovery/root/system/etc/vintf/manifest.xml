<manifest version="1.0" type="framework">
    <!--
        Keystore2 obtains the legacy HIDL service manager after registering
        its AIDL service. Recovery runs hwservicemanager, but libvintf refuses
        to return it unless the framework manifest declares the instance.
    -->
    <hal format="hidl">
        <name>android.hidl.manager</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.2::IServiceManager/default</fqname>
    </hal>
</manifest>
